PORT=4000
NODE_ENV=development

# MySQL connection string for Prisma
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/rano"

# Mobile JWT access token lifetime is 15 minutes
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Admin access token lifetime in seconds (7 days by default)
ADMIN_JWT_EXPIRES_IN_SECONDS=604800

# Admin panel account credentials used by `npm run prisma:seed`.
# Passwords are stored as scrypt hashes in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SUBADMIN_USERNAME=subadmin
SUBADMIN_PASSWORD=replace-with-another-long-random-password

# Percent of each bet credited as commission (0-100).
# Commission is split equally between admin and subadmin account balances.
COMMISSION_PERCENT=10

# RapidAPI key for Yahoo Finance market quotes
# https://rapidapi.com/davethebeast/api/yahoo-finance166/playground/marketGetQuotes
RAPIDAPI_KEY=
RAPIDAPI_HOST=yahoo-finance166.p.rapidapi.com
YAHOO_QUOTES_URL=https://yahoo-finance166.p.rapidapi.com/api/market/get-quote-v2
RESULT_DELAY_MINUTES=5
RESULT_WAIT_MINUTES=15
RESULT_CRON_SECRET=replace-with-a-long-random-secret

# Firebase Admin – path to service account JSON downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Comma-separated origins allowed by CORS (Mobile often has no Origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
